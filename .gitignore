# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Desktop.ini
ehthumbs.db

# Local model cache (Transformers.js downloads models to browser cache, not disk,
# but if any local model files land here, exclude them)
*.onnx
*.onnx.data
/models/

# Large binary assets that shouldn't be in source control
*.wasm

# PDF.js worker is generated via postinstall — exclude the copy in public
/public/pdf.worker.min.mjs
/public/pdf.worker.mjs

# Logs
logs/
*.log

# Optional: local IndexedDB export dumps
*.idb
